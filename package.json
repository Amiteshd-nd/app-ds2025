{
  "name": "namma-quest",
  "private": true,
  "version": "0.0.0",
  "description": "Namma Quest — a top-down pixel RPG set in Bengaluru. Phaser 3 + React, shipped as an installable PWA.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-maps.mjs && node scripts/validate-content.ts && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:maps": "node scripts/validate-maps.mjs",
    "preview": "vite preview",
    "validate:content": "node scripts/validate-content.ts",
    "validate": "node scripts/validate-maps.mjs && node scripts/validate-content.ts",
    "art": "node scripts/generate-art.mjs && node scripts/generate-street-map.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
