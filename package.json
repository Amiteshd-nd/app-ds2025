{
  "name": "bangalore-times",
  "private": true,
  "version": "0.0.0",
  "description": "Bangalore Times — a top-down pixel RPG set in Bengaluru. Phaser 3 + React, shipped as an installable PWA.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-maps.mjs && node scripts/validate-content.ts && node scripts/validate-platform.mjs && tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:maps": "node scripts/validate-maps.mjs",
    "preview": "vite preview",
    "validate:content": "node scripts/validate-content.ts",
    "validate": "node scripts/validate-maps.mjs && node scripts/validate-content.ts && node scripts/validate-platform.mjs",
    "art": "node scripts/generate-art.mjs && node scripts/generate-street-map.mjs",
    "validate:platform": "node scripts/validate-platform.mjs",
    "build:web": "pnpm build",
    "cap:sync": "pnpm build && cap sync",
    "cap:android": "pnpm cap:sync && cap open android",
    "cap:ios": "pnpm cap:sync && cap open ios",
    "playground": "vite --port 6175 --strictPort --open /playground.html",
    "mocks": "vite docs/mocks --port 6176 --strictPort --open /p6-style-board/p6-mock-board.html"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "phaser": "^3.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "opentype.js": "1.3.4",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
